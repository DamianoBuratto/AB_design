# Input file for gmx_MMPBSA - Linear Poisson-Boltzmann (Ab-pHLA binding affinity)
# System: Ab-pHLA complex (antibody H+L chains binding pHLA P+A), CHARMM36m force field
# Trajectory: 150 ns production MD, 500 ps/frame ~ 300 frames per replica
#
# Groups in NDX file (0-based indexing):
#   group 0 = receptor  (pHLA: peptide P + HLA A, 3009 atoms)
#   group 1 = ligand    (antibody: heavy H + light L, 3495 atoms)
#
# Run command:
#   gmx_MMPBSA -O -nogui -i mmpbsa_LinearPB.in \
#       -cp topol_prot.top -cs design_prot.tpr \
#       -ci index_mmpbsa.ndx -cg 0 1 \
#       -ct design_prot_r1.xtc -cr design_chPAHL.pdb \
#       -eo gmx_MMPBSA_plot.csv


&general
sys_name="Ab_pHLA_LinearPB",
startframe=1,
endframe=99999999,
interval=10,
# PB solvation energy depends strongly on atomic radii defining the dielectric boundary.
# PBRadii=7 → use CHARMM-compatible atomic radii
PBRadii=7,
/

&pb
# radiopt=0 → use radii from topology (CHARMM) 
radiopt=0,
istrng=0.15,
# Internal dielectric constant (solute); Higher indi weakens electrostatic interactions and often makes binding less extreme (more realistic)
# 1.0 → fully explicit electrostatics (standard); 
# 2–4 → mimic electronic polarization (for proteins, sometimes indi = 2.0 is used as a correction)
indi=1.0,
# External dielectric constant (solvent); exdi = 80.0 → water
exdi=80.0,
# inp defines the nonpolar solvation model. 
# inp=1 → surface-area model (simple; robust; usually stable)
# inp=2 → cavity + dispersion model (more “physical”; can overestimate dispersion)
inp=1,
/